{
  "name": "pronto-stock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:check": "tsx server/scripts/check-database.ts",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production SERVE_FRONTEND=true tsx server/index.ts",
    "test": "tsx server/scripts/test-database.ts",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:import": "tsx server/scripts/import-json.ts",
    "test:db": "tsx server/scripts/test-database.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "start:api": "node build/server/index.js",
    "test:http": "node --import tsx --test server/tests/http.test.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
